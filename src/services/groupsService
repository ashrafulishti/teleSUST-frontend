import api from './api'

export async function getGroups() {
  const response = await api.get('/groups')
  return response.data.groups ?? []
}

export async function createGroup({ name, description, join_password, is_read_only = false }) {
  const response = await api.post('/groups', { name, description: description || undefined, join_password, is_read_only })
  return response.data
}

export async function joinGroup(groupId, joinPassword) {
  const response = await api.post(`/groups/${groupId}/join`, { join_password: joinPassword })
  return response.data
}

export async function getChannels(groupId) {
  const response = await api.get(`/groups/${groupId}/channels`)
  return response.data.channels ?? []
}

export async function createChannel(groupId, { name, topic }) {
  const response = await api.post(`/groups/${groupId}/channels`, { name, topic: topic || undefined })
  return response.data
}
